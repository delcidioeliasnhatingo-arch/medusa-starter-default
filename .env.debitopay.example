# Copy these variables into Render Environment. Never commit real values.
# Obtain the live or sandbox key in the Debito Pay merchant dashboard.
DEBITOPAY_API_KEY=
DEBITOPAY_MERCHANT_ID=
DEBITOPAY_WALLET_CODE=

# Debito Pay Payments API base URL
DEBITOPAY_API_BASE_URL=https://gyqoaningqhurhvdugne.supabase.co/functions/v1

# For South African sales use ZAR + PayFast, if enabled on your Debito Pay wallet.
DEBITOPAY_CURRENCY=ZAR
DEBITOPAY_PAYMENT_METHOD=payfast

# Must be an HTTPS page on the AVEART storefront that handles payment return.
DEBITOPAY_RETURN_URL=

# Copy the webhook signing secret from Debito Pay dashboard.
DEBITOPAY_WEBHOOK_SECRET=
